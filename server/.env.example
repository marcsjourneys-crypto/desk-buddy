# Desk Buddy server settings.
# Copy to .env (gitignored) and fill in. Leave a value blank to use its default.
# Keep every value in THIS file blank — tests enforce it.

# --- LLM ---
# Model provider. Only "anthropic" for now; OpenAI-compatible providers (e.g. Kimi) come later.
LLM_PROVIDER=
# Anthropic API key (required).
ANTHROPIC_API_KEY=
# Claude model id. Default: claude-haiku-5-5
LLM_MODEL=
# Thinking effort: low | medium | high | xhigh | max. Default: low (fastest replies)
LLM_EFFORT=

# --- Speech-to-text (faster-whisper) ---
# Whisper model size. Default: base.en
STT_MODEL=
# cpu | cuda. Default: cpu
STT_DEVICE=
# CTranslate2 compute type. Default: int8 (best on CPU)
STT_COMPUTE_TYPE=

# --- Text-to-speech ---
# piper | sapi. Default: piper
#   piper: a local neural voice (TTS_VOICE). sapi: the built-in Windows voice (fallback).
TTS_ENGINE=
# Piper voice: a voice name, downloaded once into VOICES_DIR (about 60 MB), or a path to
# an .onnx file (with its .onnx.json next to it). Default: en_GB-northern_english_male-medium
TTS_VOICE=
# Piper speaking speed, 0.5-2.0 (1.25 = a quarter faster). Default: 1.0
TTS_SPEED=
# Folder for Piper voices. Default: %LOCALAPPDATA%\desk-buddy\voices
VOICES_DIR=

# --- Personality ---
# Max sentences per spoken reply. Default: 2
MAX_SENTENCES=
# How many recent exchanges CARL remembers (cleared on restart or by saying "new topic"). Default: 20
HISTORY_TURNS=

# --- Push-to-talk (M1, before the robot exists) ---
# Hold this key to talk: right_ctrl, left_ctrl, right_alt, right_shift, scroll_lock, pause,
# f1..f12, or a hex virtual-key code like 0xA3. Default: right_ctrl
PTT_KEY=

# --- Obsidian ---
# Absolute path to CARL's vault folder. Blank = note tools off.
OBSIDIAN_VAULT_PATH=
# Folder for daily notes, relative to the vault. Default: Daily
OBSIDIAN_DAILY_FOLDER=
# Folder for idea notes, relative to the vault. Default: Ideas
OBSIDIAN_IDEAS_FOLDER=

# --- Robot link ---
# Shared secret the robot sends in its hello message. At least 16 characters.
# Blank = robot link off (PC mic/speaker only). Make one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
ROBOT_TOKEN=
# Interface to listen on. Default: 127.0.0.1 (this PC only, enough for the fake robot).
# The real robot needs 0.0.0.0 (the LAN) plus the Windows Firewall rule in docs/protocol.md.
# CARL then logs the address to give the robot ("server <lan-ip>:<port>").
SERVER_HOST=
# WebSocket port. Default: 8765
SERVER_PORT=

# --- Dashboard (M8) ---
# Port of the dashboard web page, which only listens on this PC (http://127.0.0.1:<port>).
# Default: 8766
DASHBOARD_PORT=

# --- Computer control (M7) ---
# on | off. Default: off. Lets CARL act on this PC (Spotify for now). Allowlisted actions
# only, at most 3 per question and 8 a minute, each one logged.
COMPUTER_CONTROL=
# Client ID of your Spotify developer app (PKCE login, so no client secret). Blank = no
# music tools. After setting it, log in once: uv run python -m desk_buddy.spotify_login
SPOTIFY_CLIENT_ID=
# on | off. Default: on. Lower Spotify's volume while CARL listens and talks.
MUSIC_DUCK=
# YouTube Data API v3 key (a secret). Blank = CARL can open YouTube searches but not play a
# chosen video. Create one in a Google Cloud project: enable "YouTube Data API v3", then
# create an API key restricted to that API.
YOUTUBE_API_KEY=

# --- Web search ---
# on | off. Default: on. Lets CARL look up current facts (news, weather, scores, opening
# hours) with Anthropic's web search tool, which runs on Anthropic's side and is billed
# per search. It must also be enabled for your API key in the Anthropic Console.
WEB_SEARCH=
# Searches per question, 1-5. Default: 2
WEB_SEARCH_MAX=

# --- Skills ---
# Folder of your own Python skills, one subfolder each (skill.json + main.py). Blank =
# skills off. Each skill runs only after you tick it on the dashboard's Apps tab.
SKILLS_DIR=
